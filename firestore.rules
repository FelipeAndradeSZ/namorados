rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // SEC-02 FIX: All operations require anonymous authentication.
    // This prevents unauthenticated API abuse from external clients.

    // Checklist collection: authenticated users can read/write
    match /checklist/{itemId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(["text", "category", "checked", "checkedBy"])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 50
        && request.resource.data.checked is bool;
      allow update: if request.auth != null
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500;
      allow delete: if request.auth != null;
    }

    // Days collection: authenticated users can read/write
    match /days/{dayId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.data.keys().hasAll(["date", "title"])
        && request.resource.data.date is string
        && request.resource.data.date.size() <= 20
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200;
    }

    // Activities collection: authenticated users can read/write
    match /activities/{activityId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(["date", "time", "description", "location", "icon"])
        && request.resource.data.date is string
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.location is string
        && request.resource.data.location.size() <= 500;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
