rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Coleções da viagem do casal — leitura pública, escrita restrita
    // Quando Firebase Auth estiver ativo, trocar `if true` por `if request.auth != null`
    match /checklist/{itemId} {
      allow read: if true;
      allow write: if true;
    }

    match /days/{dayId} {
      allow read: if true;
      allow write: if true;
    }

    match /activities/{activityId} {
      allow read: if true;
      allow write: if true;
    }

    // Progresso do Destino 1000 — acesso somente com autenticação futura
    match /destino1000/{userId}/{document=**} {
      allow read, write: if false;
    }

    // Nega acesso a qualquer outra coleção desconhecida por padrão
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
