rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permite leitura e escrita nas coleções públicas da viagem
    match /checklist/{itemId} {
      allow read, write: if true;
    }

    match /days/{dayId} {
      allow read, write: if true;
    }

    match /activities/{activityId} {
      allow read, write: if true;
    }

    // Nega acesso a qualquer outra coleção desconhecida por padrão
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
